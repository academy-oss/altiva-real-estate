# ALTIVA Real Estate — Environment Variables (example)
# ---------------------------------------------------------------------------
# Copy this file to ".env" only when the public server API is available.
# No Zoho credentials, tokens, or private endpoints belong in this file.
#
# NOTE: Every VITE_ variable is public and visible to website visitors.
# The public API below must call Zoho server-side and keep OAuth secrets there.

# Base URL of the website's public server API (not a Zoho URL).
# Example: https://api.altivaproperties.com
VITE_PUBLIC_API_BASE_URL=

# Local design testing only. This is ignored in production builds.
VITE_ENABLE_MOCK_SUBMISSIONS=false

# Public WhatsApp number used across CTA buttons (E.164 without the "+").
VITE_WHATSAPP_NUMBER=96557775289

# Public contact details shown in the footer / contact page.
VITE_CONTACT_EMAIL=sales@altivaproperties.com
VITE_CONTACT_PHONE=+9652220035

# Optional analytics ids (leave empty to disable).
VITE_GOOGLE_ANALYTICS_ID=
VITE_META_PIXEL_ID=
